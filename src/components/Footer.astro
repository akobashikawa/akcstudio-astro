				<path d="M32 2C15.4 2 2 15.4 2 32s13.4 30 30 30 30-13.4 30-30S48.6 2 32 2zm0 54c-13.3 0-24-10.7-24-24S18.7 8 32 8s24 10.7 24 24-10.7 24-24 24zm-6.5-24c0-3.3-2.3-5.5-5.3-5.5-3.2 0-5.5 2.5-5.5 5.5s2.3 5.5 5.5 5.5c3 0 5.3-2.2 5.3-5.5zm12 0c0-3.3-2.3-5.5-5.3-5.5-3.2 0-5.5 2.5-5.5 5.5s2.3 5.5 5.5 5.5c3 0 5.3-2.2 5.3-5.5z" />
